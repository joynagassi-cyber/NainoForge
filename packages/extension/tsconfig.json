{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@extension/*": ["./src/*"],
      "@nainoforge/shared": ["../shared/src/index.ts"],
      "@nainoforge/shared/*": ["../shared/src/*"],
      "@nainoforge/core": ["../core/src/index.ts"],
      "@nainoforge/core/*": ["../core/src/*"],
      "@nainoforge/imprint": ["../imprint/src/index.ts"],
      "@nainoforge/imprint/*": ["../imprint/src/*"],
      "@nainoforge/fsrs": ["../fsrs/src/index.ts"],
      "@nainoforge/fsrs/*": ["../fsrs/src/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../shared"
    },
    {
      "path": "../fsrs"
    },
    {
      "path": "../imprint"
    }
  ]
}
